extends base

block content
  h1 Your Weekly Insight 📊
  p Hello #{firstName}, here's a look at your financial activity for the week of <span class="highlight">#{startOfWeek} – #{endOfWeek}</span>.
  
  // METRICS GRID
  table(role='presentation', border='0', cellpadding='0', cellspacing='0', style='width: 100%; border-spacing: 0; margin: 32px 0;')
    tr
      td(style='width: 50%; padding-right: 12px; vertical-align: top;')
        div(style='background: #334155; border-radius: 16px; padding: 20px; border: 1px solid #475569;')
          p(style='margin: 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;') Income
          p(style='margin: 8px 0 0; font-size: 24px; font-weight: 700; color: #D1FF4F;') #{incomeFormatted}
      td(style='width: 50%; padding-left: 12px; vertical-align: top;')
        div(style='background: #334155; border-radius: 16px; padding: 20px; border: 1px solid #475569;')
          p(style='margin: 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;') Expenses
          p(style='margin: 8px 0 0; font-size: 24px; font-weight: 700; color: #F87171;') #{expensesFormatted}
  
  div(style='background: #334155; border-radius: 16px; padding: 24px; border: 1px solid #475569; margin-bottom: 32px;')
    p(style='margin: 0 0 8px; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;') Budget Progress
    p(style='margin: 0 0 16px; font-size: 20px; font-weight: 600; color: #F8FAFC;') You've used <span class="highlight">#{percentUsed}%</span> of your monthly budget.
    // PROGRESS BAR
    div(style='width: 100%; background: #1E293B; height: 8px; border-radius: 4px; overflow: hidden;')
      div(style=`width: ${percentUsed}%; background: #D1FF4F; height: 100%; border-radius: 4px;`)
    p(style='margin: 16px 0 0; font-size: 14px; color: #94A3B8;') #{comparisonText}
  
  p(style='font-style: italic; color: #F8FAFC; margin-bottom: 32px;') #{friendlyComment}
  
  table.btn(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') View Detailed Analytics 📈
  
  p(style='margin-top: 32px; font-size: 14px;') Stay disciplined and keep those financial goals in sight!
  p(style='font-weight: 600; color: #F8FAFC;') — Your Plete Financial Companion

