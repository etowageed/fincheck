extends base

block content
  h1 Your weekly financial summary
  p Hi #{firstName},
  p Here is a summary of your financial activity for <span class="highlight">#{startOfWeek} – #{endOfWeek}</span>.

  .details-box
    .detail-item
      p.detail-label Income
      p.detail-value #{incomeFormatted}
    .detail-item
      p.detail-label Expenses
      p.detail-value #{expensesFormatted}
    .detail-item
      p.detail-label Saved &amp; Invested
      p.detail-value #{savingsFormatted}
    .detail-item
      p.detail-label Monthly budget used
      p.detail-value #{percentUsed}%
    .detail-item
      p.detail-label Week-over-week trend
      p.detail-value #{comparisonText}

  p #{friendlyComment}

  table.btn(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') View Detailed Analytics

  p.signoff — Team Plete

