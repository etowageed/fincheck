extends base

block content
  h1 Security: Password Reset 🛡️
  p We received a request to reset the password for your Plete account. If this was you, please click the button below to choose a new one.
  
  table.btn(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Reset Password
  
  p(style='margin-top: 32px; font-size: 14px; color: #64748B;') This link is valid for only <span class="highlight">10 minutes</span>. If you didn't request a password reset, you can safely ignore this email — your account is still secure.

