extends base

block content
  h1 Reset your password
  p Hi #{firstName},
  p We received a request to reset the password for your Plete account. Use the button below to choose a new password:

  table.btn(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Reset Password

  p(style='color: #64748B; font-size: 14px;') Note: This link is valid for <span class="highlight">10 minutes</span>. If you didn't request a password reset, please ignore this email or contact support if you have concerns.
  p.signoff — Team Plete

