extends base

block content
  h1 Welcome to Plete Premium ✨
  p Hi #{firstName}, you've just leveled up! We're thrilled to have you as a premium member. 
  p You now have full access to our most powerful tools:
  
  ul(style='list-style-type: none; padding: 0; margin-bottom: 32px;')
    li(style='margin-bottom: 16px; display: flex; align-items: center;')
      span(style='margin-right: 12px; font-size: 20px;') 📈
      span <strong style="color: #F8FAFC;">Advanced Analytics:</strong> Deep dive into your spending patterns with AI-driven insights.
    li(style='margin-bottom: 16px; display: flex; align-items: center;')
      span(style='margin-right: 12px; font-size: 20px;') 🌍
      span <strong style="color: #F8FAFC;">Multi-currency Support:</strong> Seamlessly manage accounts across the globe.
    li(style='margin-bottom: 16px; display: flex; align-items: center;')
      span(style='margin-right: 12px; font-size: 20px;') 👩‍🏫
      span <strong style="color: #F8FAFC;">Priority Support:</strong> Skip the line and get answers when you need them most.
  
  table.btn(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Explore Premium Features
  
  p(style='margin-top: 32px; font-size: 14px;') We're excited to be part of your financial growth.
  p(style='font-weight: 600; color: #F8FAFC;') — The Plete Finance Team

